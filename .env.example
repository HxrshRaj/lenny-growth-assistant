# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# ============ Database ============
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
POSTGRES_PORT=5432
# Used by the API. When running via docker-compose the host is the service name
# "db"; when running the API on your host machine against the dockerized DB, use
# "localhost".
DATABASE_URL=postgresql+psycopg://lenny:lenny@db:5432/lenny

# ============ Model provider toggle ============
# "anthropic" (cloud Claude) or "ollama" (local). This is the ONLY variable you
# need to change to switch providers -- no code changes required.
MODEL_PROVIDER=ollama

# --- Anthropic (cloud) ---
# Required only when MODEL_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (local) ---
# Required only when MODEL_PROVIDER=ollama. Point at wherever `ollama serve` is
# running. From inside docker-compose on Windows/Mac, use host.docker.internal;
# on Linux add `extra_hosts: host.docker.internal:host-gateway` (already in
# docker-compose.yml) or point directly at the host IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must match a model you have actually pulled (`ollama pull <name>` / `ollama list`).
OLLAMA_MODEL=mymodel
OLLAMA_TIMEOUT_SECONDS=240
# Ollama defaults to a 2048-token context window regardless of what the model
# actually supports -- this must match (or be below) your model's real context
# size or you'll get empty completions with no error. 4096 matches this build's
# default local model (`ollama show <model>` to check yours).
OLLAMA_NUM_CTX=4096

# ============ Retrieval ============
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15

# ============ App ============
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============ Frontend (apps/web) ============
VITE_API_BASE_URL=http://localhost:8000
