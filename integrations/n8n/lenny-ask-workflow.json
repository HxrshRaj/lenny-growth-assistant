{
  "name": "Lenny Growth Assistant - signed ask",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lenny-ask",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "lenny-ask"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst question = String($input.first().json.body?.question ?? '').trim();\nif (!question) { return [{ json: { valid: false } }]; }\nconst body = JSON.stringify({ question });\nconst ts = String(Math.floor(Date.now() / 1000));\nconst secret = $env.LENNY_WEBHOOK_SECRET;\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\nreturn [{ json: { valid: true, body, ts, sig } }];"
      },
      "id": "n2",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Has question?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENNY_API_URL }}/webhooks/ask",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Timestamp", "value": "={{ $json.ts }}" },
            { "name": "X-Signature", "value": "={{ $json.sig }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": { "timeout": 120000, "response": { "response": { "neverError": true } } }
      },
      "id": "n4",
      "name": "Ask Lenny API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "n5",
      "name": "Respond with answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'question is required' } }}",
        "options": { "responseCode": 400 }
      },
      "id": "n6",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Sign request", "type": "main", "index": 0 }]] },
    "Sign request": { "main": [[{ "node": "Has question?", "type": "main", "index": 0 }]] },
    "Has question?": {
      "main": [
        [{ "node": "Ask Lenny API", "type": "main", "index": 0 }],
        [{ "node": "Respond 400", "type": "main", "index": 0 }]
      ]
    },
    "Ask Lenny API": { "main": [[{ "node": "Respond with answer", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
